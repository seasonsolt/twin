# 文字聊天模型密钥；对应 twin.toml 的 [llm] api_key_env
TWIN_LLM_KEY=
# 可选：聊天专用模型密钥
# TWIN_LLM_KEY_DEEPSEEK=
# 可选：工作模式网页搜索（DeepSeek）密钥；聊天模型已在 DeepSeek 时不用填
# TWIN_SEARCH_KEY=
# 可选：外部向量服务密钥，默认本机轻量向量不需要
# TWIN_EMBED_KEY=
# 可选：语音合成服务密钥
# TWIN_TTS_KEY=
# 可选：录音转写服务密钥
# TWIN_ASR_KEY=
# 可选：邮箱登录的邮件密码
# TWIN_SMTP_PASSWORD=
# 可选：对外接口令牌
# TWIN_API_TOKEN=
# 可选：企业微信通讯录密钥，按工号取同事头像（配合 twin.toml 的 [wecom] corp_id）
# TWIN_WECOM_CONTACTS_SECRET=
